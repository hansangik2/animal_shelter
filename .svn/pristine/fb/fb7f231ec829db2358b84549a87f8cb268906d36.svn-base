<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<%@ page import="kr.or.ddit.member.vo.MemberVO"%>

<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>게시글 작성</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com/"
	crossorigin="anonymous">
<link
	href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;900&display=swap"
	rel="stylesheet">
<link
	href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
	rel="stylesheet">

<link rel="stylesheet"
	href="${pageContext.request.contextPath}/css/common/common.css">
<link rel="stylesheet"
	href="${pageContext.request.contextPath}/css/board-write.css">
</head>
<body>

	<%@ include file="/view/common/header.jsp"%>

	<main class="write-page">
		<div class="write-inner">

			<div class="back-link">
				<a href="${pageContext.request.contextPath}/board/list.do">목록으로
					돌아가기</a>
			</div>

			<h2 class="write-page-title">게시글 작성</h2>
			<p class="write-page-sub">게시판 유형, 제목, 내용을 입력해주세요.</p>

			<div class="write-box">
				<form method="post"
					action="${pageContext.request.contextPath}/board/write.do"
					enctype="multipart/form-data">

					<table class="write-table">
						<tr>
							<th>작성자 ID</th>
							<td><input type="text" name="memberId" value="a001">
							</td>
						</tr>
						<tr>
							<th>게시판 유형</th>
							<td>
								<%
								MemberVO loginUser = (MemberVO) session.getAttribute("loginUser");
								String userRole = "";

								if (loginUser != null) {
									userRole = loginUser.getRole();
								}
								%> <select name="boardType">
									<%
									loginUser = (kr.or.ddit.member.vo.MemberVO) session.getAttribute("loginUser");

									userRole = "USER";

									if (loginUser != null) {
										userRole = loginUser.getRole();
									}
									%>

									<%
									if (!"USER".equals(userRole)) {
									%>
									<option value="공지">공지사항</option>
									<%
									}
									%>

									<option value="자유">자유게시판</option>
									<option value="문의">문의</option>
									<option value="입양후기">입양후기</option>
									<option value="자원봉사후기">자원봉사후기</option>
							</select>
							</td>
						</tr>
						<tr>
							<th>제목</th>
							<td><input type="text" name="title"></td>
						</tr>



						<tr>
							<th>내용</th>
							<td><textarea name="content" rows="10"></textarea></td>
						</tr>

						<tr>
							<th>첨부파일</th>
							<td><input type="file" name="uploadFile" multiple></td>
						</tr>

					</table>

					<div class="write-btn-area">
						<button type="submit" class="write-btn orange-btn">등록완료</button>
						<a href="${pageContext.request.contextPath}/board/list.do"
							class="write-btn gray-btn">취소</a>
					</div>


				</form>
			</div>
		</div>
	</main>

	<%@ include file="/view/common/footer.jsp"%>



</body>
</html>