<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.or.ddit.board.dao.IBoardDao">

    <!-- 게시글 목록 조회 -->
    <select id="selectBoardList" parameterType="map" resultType="kr.or.ddit.board.vo.BoardVO">
        SELECT
            BOARD_ID AS boardId,
            MEMBER_ID AS memberId,
            BOARD_TYPE AS boardType,
            TITLE AS title,
            CONTENT AS content,
            VIEW_COUNT AS viewCount,
            LIKE_COUNT AS likeCount,
            TO_CHAR(CREATE_DATE, 'YYYY-MM-DD') AS createDate
        FROM BOARD
        WHERE 1 = 1
        <if test="boardType != null and boardType != '' and boardType != '전체'">
            AND BOARD_TYPE = #{boardType}
        </if>
        <if test="keyword != null and keyword != ''">
            AND TITLE LIKE '%' || #{keyword} || '%'
        </if>
        ORDER BY BOARD_ID DESC
    </select>

    <!-- 게시글 상세 조회 -->
    <select id="selectBoard" parameterType="int" resultType="kr.or.ddit.board.vo.BoardVO">
        SELECT
            BOARD_ID AS boardId,
            MEMBER_ID AS memberId,
            BOARD_TYPE AS boardType,
            TITLE AS title,
            CONTENT AS content,
            VIEW_COUNT AS viewCount,
            LIKE_COUNT AS likeCount,
            TO_CHAR(CREATE_DATE, 'YYYY-MM-DD') AS createDate
        FROM BOARD
        WHERE BOARD_ID = #{value}
    </select>

    <!-- 조회수 증가 -->
    <update id="updateViewCount" parameterType="int">
        UPDATE BOARD
        SET VIEW_COUNT = VIEW_COUNT + 1
        WHERE BOARD_ID = #{value}
    </update>

    <!-- 게시글 등록 -->
    <insert id="insertBoard" parameterType="kr.or.ddit.board.vo.BoardVO">
        <selectKey keyProperty="boardId" resultType="int" order="BEFORE">
            SELECT SEQ_BOARD.NEXTVAL FROM DUAL
        </selectKey>
        
        INSERT INTO BOARD (
            BOARD_ID,
            MEMBER_ID,
            BOARD_TYPE,
            TITLE,
            CONTENT,
            VIEW_COUNT,
            LIKE_COUNT,
            CREATE_DATE
        ) VALUES (
            #{boardId},
            #{memberId},
            #{boardType},
            #{title},
            #{content},
            0,
            0,
            SYSDATE
        )
    </insert>

    <!-- 게시글 수정 -->
    <update id="updateBoard" parameterType="kr.or.ddit.board.vo.BoardVO">
        UPDATE BOARD
        SET
            BOARD_TYPE = #{boardType},
            TITLE = #{title},
            CONTENT = #{content}
        WHERE BOARD_ID = #{boardId}
    </update>
    
    <!-- 게시글 삭제 -->
    <delete id="deleteBoard" parameterType="int">
        DELETE FROM BOARD
        WHERE BOARD_ID = #{value}
    </delete>
    
    <!--댓글 목록 조회-->
    <select id="selectCommentList" parameterType="int" resultType="kr.or.ddit.board.vo.BoardCommentVO">
        SELECT
            COMMENT_ID AS commentId,
            BOARD_ID AS boardId,
            MEMBER_ID AS memberId,
            CONTENT AS content,
            TO_CHAR(CREATE_DATE, 'YYYY-MM-DD') AS createDate
        FROM BOARD_COMMENT
        WHERE BOARD_ID = #{value}
        ORDER BY COMMENT_ID DESC  
    </select>
    
    <!-- 댓글 등록 -->
    <insert id="insertComment" parameterType="kr.or.ddit.board.vo.BoardCommentVO">
        INSERT INTO BOARD_COMMENT (
            COMMENT_ID,
            BOARD_ID,
            MEMBER_ID,
            CONTENT,
            CREATE_DATE
        ) VALUES (
            SEQ_BOARD_COMMENT.NEXTVAL,
            #{boardId},
            #{memberId},
            #{content},
            SYSDATE
        )
        
    </insert>
    
    <!-- 댓글 삭제 -->
    <delete id="deleteComment" parameterType="int">
        DELETE FROM BOARD_COMMENT
        WHERE COMMENT_ID = #{value}
    </delete>
    
    <!-- 추천수 증가 -->
    <update id="updateLikeCount" parameterType="int">
        UPDATE BOARD
        SET LIKE_COUNT = LIKE_COUNT + 1
        WHERE BOARD_ID = #{value}
    </update>
    
    <!-- 회원 상태 조회 -->
    <select id="getMemberStatus" parameterType="string" resultType="string">
        SELECT STATUS
        FROM MEMBER
        WHERE MEMBER_ID = #{memberId}
    </select>
    
    <!-- 첨부파일 등록 -->
    <insert id="insertBoardFile" parameterType="kr.or.ddit.board.vo.BoardFileVO">
        INSERT INTO BOARD_FILE (
            FILE_ID,
            BOARD_ID,
            ORIGIN_FILE_NAME,
            SAVE_FILE_NAME,
            FILE_PATH,
            FILE_SIZE,
            FILE_EXT,
            CREATE_DATE,
            IS_IMAGE     
        ) VALUES (
            SEQ_BOARD_FILE.NEXTVAL,
            #{boardId},
            #{originFileName},
            #{saveFileName},
            #{filePath},
            #{fileSize},
            #{fileExt},
            SYSDATE,
            #{isImage}
        )    
    </insert>
    
    <!-- 첨부파일 목록 조회 -->
    <select id="selectFileList" parameterType="int"
            resultType="kr.or.ddit.board.vo.BoardFileVO">
        SELECT
            FILE_ID AS fileId,
            BOARD_ID AS boardId,
            ORIGIN_FILE_NAME AS originFileName,
            SAVE_FILE_NAME AS saveFileName,
            FILE_PATH AS filePath        
        FROM BOARD_FILE
        WHERE BOARD_ID = #{value}
    </select>
    
    <!-- 파일 ID로 첨부파일 정보 조회 -->
    <select id="selectFile" parameterType="int"
            resultType="kr.or.ddit.board.vo.BoardFileVO">
        SELECT
            FILE_ID AS fileId,
            BOARD_ID AS boardId,
            ORIGIN_FILE_NAME AS originFileName,
            SAVE_FILE_NAME AS saveFileName,
            FILE_PATH AS filePath,
            FILE_SIZE AS fileSize,
            FILE_EXT AS fileExt,
            IS_IMAGE AS isImage
        FROM BOARD_FILE
        WHERE FILE_ID = #{value}
            </select>
</mapper>