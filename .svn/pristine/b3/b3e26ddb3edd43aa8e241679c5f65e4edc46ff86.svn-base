<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%@ page import="kr.or.ddit.member.vo.MemberVO" %>
<% 
   MemberVO user = (MemberVO) session.getAttribute("loginUser");
%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>메인 페이지</title>
</head>
<body>
   <h1>너와 나의 연결고리 메인</h1>
   
   <div class="user-menu">
     <% if (user == null) { %>
        <p>방문해 주셔서 감사합니다.</p>
        <a href="<%= request.getContextPath() %>/login.do">로그인 하러가기</a> |
        <a href="membership.jsp">회원가입</a>
     <% } else { %>
        <p><strong><%= user.getNickname() %></strong>님 반갑습니다!</p>
        <p>등급: <%= user.getRole() %></p>
        <a href="<%= request.getContextPath() %>/logout.do">로그아웃</a> |
        <a href="mypage.jsp">마이페이지</a>
     <% } %>
  </div>
  
  <nav>
     <ul>
        <li><a href="boardList.do">자유게시판</a></li>
        <li><a href="gallery.do">사진첩</a></li>
     </ul>
  </nav>

</body>
</html>