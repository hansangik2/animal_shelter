<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mypage">

    <!-- ==================================================== 
    	 		통계 카드 조회 (관심동물 / 입양신청 / 작성글)
    	 ===================================================== -->
    <select id="getMypageStats" parameterType="string" resultType="MypageStatsVO">
        SELECT
            (SELECT COUNT(*) FROM FAVORITE_ANIMAL  WHERE MEMBER_ID = #{memberId}) AS favoriteCount,
            (SELECT COUNT(*) FROM ADOPTION         WHERE MEMBER_ID = #{memberId}) AS adoptionCount,
            (SELECT COUNT(*) FROM BOARD            WHERE MEMBER_ID = #{memberId}) AS postCount
          FROM DUAL
    </select>
 
 
	<!-- =====================================================
		 				최근 활동 내역 조회
		 =====================================================
          - Oracle ROWNUM 방식으로 상위(최근) 5건 추출
          - UNION ALL 활동 종류 3가지:
           1. FAVORITE_ANIMAL  → 관심등록
           2. DONATION         → 후원완료
           3. ADOPTION         → 심사중
         ===================================================== -->
    <select id="getRecentActivities" parameterType="string" resultType="ActivityVO">
        SELECT *
          FROM (
                /* 1. 관심동물 등록 */
                SELECT
                    0                                        AS activityId,
                    'favorite'                               AS icon,
                    '''' || A.ANIMAL_NAME || ''' 을(를) 관심 목록에 추가했습니다.' AS description,
                    TO_CHAR(F.CREATE_DATE, 'YYYY.MM.DD')     AS actDate,
                    'primary'                                AS badgeType,
                    '관심등록'                               AS badgeLabel
                  FROM FAVORITE_ANIMAL F
                  JOIN ANIMAL A ON F.ANIMAL_ID = A.ANIMAL_ID
                 WHERE F.MEMBER_ID = #{memberId}
 
                UNION ALL
 
                /* 2. 후원 완료 */
                SELECT
                    0                                        AS activityId,
                    'volunteer_activism'                     AS icon,
                    TO_CHAR(D.DONATION_AMOUNT, 'FM999,999,999') || '원을 후원했습니다.' AS description,
                    TO_CHAR(D.DONATION_DATE, 'YYYY.MM.DD')   AS actDate,
                    'green'                                  AS badgeType,
                    '후원완료'                               AS badgeLabel
                  FROM DONATION D
                 WHERE D.MEMBER_ID = #{memberId}
 
                UNION ALL
 
                /* 3. 입양 신청 */
                SELECT
                    0                                        AS activityId,
                    'assignment'                             AS icon,
                    '''' || A.ANIMAL_NAME || ''' 의 입양 신청서가 접수되었습니다.' AS description,
                    TO_CHAR(AD.APPLY_DATE, 'YYYY.MM.DD')     AS actDate,
                    'blue'                                   AS badgeType,
                    '심사중'                                 AS badgeLabel
                  FROM ADOPTION AD
                  JOIN ANIMAL A ON AD.ANIMAL_ID = A.ANIMAL_ID
                 WHERE AD.MEMBER_ID = #{memberId}
 
                ORDER BY actDate DESC
               )
         WHERE ROWNUM &lt;= 5
    </select>


	<!-- =====================================================
         					회원 정보 수정
         ===================================================== -->
         
    <!-- pw, img는 입력한 경우에만 UPDATE -->
    <update id="updateMember" parameterType="MemberVO">
        UPDATE MEMBER
           SET NICKNAME   = #{nickname},
               EMAIL      = #{email},
               PHONE      = #{phone}
               <if test="memberPw != null and memberPw != ''">
               , MEMBER_PW = #{memberPw}
               </if>
               <if test="profileImg != null and profileImg != ''">
               , PROFILE_IMG = #{profileImg}
               </if>
         WHERE MEMBER_ID  = #{memberId}
    </update>
 
    <!-- 현재 비밀번호 일치 여부 확인 - 일치하는 행이 있으면 1, 없으면 0 반환 -->
    <select id="checkCurrentPw" parameterType="map" resultType="int">
        SELECT COUNT(*)
          FROM MEMBER
         WHERE MEMBER_ID = #{memberId}
           AND MEMBER_PW = #{currentPw}
    </select>
 
    <!-- 닉네임 중복 확인 - 0이면 사용 가능, 1 이상이면 중복 -->
    <select id="countByNickname" parameterType="string" resultType="int">
        SELECT COUNT(*)
          FROM MEMBER
         WHERE NICKNAME = #{nickname}
    </select>
    
    <!-- 회원 탈퇴 (소프트 삭제) - 물리 삭제 대신 STATUS = 'N' 으로 변경 -->
    <update id="withdrawMember"
            parameterType="string">
        UPDATE MEMBER
           SET STATUS = 'N'
         WHERE MEMBER_ID = #{memberId}
    </update>
    
    
    <!-- =====================================================
     	 					관심동물
    	 ===================================================== -->
    	 
    <!-- 총 개수 조회 -->
	<select id="getFavoriteAnimalCount" parameterType="string" resultType="int">
	    SELECT COUNT(*)
	      FROM FAVORITE_ANIMAL F
	     WHERE F.MEMBER_ID = #{memberId}
	</select>
	
	<!-- 관심동물 목록 조회 (페이징)
	     - FAVORITE_ANIMAL 테이블 기준 최신 등록순 정렬
	     - 이미지가 없는 동물도 목록에 포함 (LEFT OUTER JOIN) -->
	<select id="getFavoriteAnimalList" parameterType="map" resultType="AnimalVO">
	    SELECT *
	      FROM (
	            SELECT ROWNUM AS RNUM, T.*
	              FROM (
	                    SELECT
	                        A.ANIMAL_ID         AS animalId,
	                        A.ANIMAL_NAME       AS animalName,
	                        A.ANIMAL_TYPE       AS animalType,
	                        A.BREED             AS breed,
	                        A.GENDER            AS gender,
	                        A.AGE               AS age,
	                        A.WEIGHT            AS weight,
	                        A.ADOPTION_STATUS   AS adoptionStatus,
	                        A.PERSONALITY       AS personality,
	                        A.VIEW_COUNT        AS viewCount,
	                        A.CREATE_DATE       AS createDate,
	                        I.SAVE_FILE_NAME    AS mainImage,
	                        1                   AS isFavorite
	                      FROM FAVORITE_ANIMAL F
	                      JOIN ANIMAL A
	                        ON F.ANIMAL_ID = A.ANIMAL_ID
	                      LEFT OUTER JOIN ANIMAL_IMAGE I
	                        ON A.ANIMAL_ID = I.ANIMAL_ID
	                       AND (I.IS_MAIN = 'Y' OR I.IS_MAIN IS NULL)
	                     WHERE F.MEMBER_ID = #{memberId}
	                     ORDER BY F.CREATE_DATE DESC
	                   ) T
	           )
	     WHERE RNUM BETWEEN #{start} AND #{end}
	</select>
	
	<!-- 관심동물 찜 해제 (animal.xml의 deleteFavorite과 동일하나 mypage 서비스에서 호출할 경우 여기서도 정의) -->
	<delete id="removeFavoriteAnimal" parameterType="map">
	    DELETE FROM FAVORITE_ANIMAL
	     WHERE ANIMAL_ID = #{animalId}
	       AND MEMBER_ID = #{memberId}
	</delete>
	
	
	<!-- =====================================================
	     					입양 신청 내역
	     ===================================================== -->
	     
	<!-- 입양 신청 총 개수 조회(status 가 null 이면 전체, 값이 있으면 해당 상태) -->
	<select id="getAdoptionHistoryCount" parameterType="map" resultType="int">
	    SELECT COUNT(*)
	      FROM ADOPTION
	     WHERE MEMBER_ID = #{memberId}
	    <if test="status != null and status != ''">
	       AND STATUS = #{status}
	    </if>
	</select>
	
	<!-- 입양 신청 목록 조회 (페이징) -->
	<select id="getAdoptionHistoryList" parameterType="map" resultType="AdoptionHistoryVO">
	    SELECT *
	      FROM (
	            SELECT ROWNUM AS RNUM, T.*
	              FROM (
	                    SELECT
	                        AD.ADOPTION_ID                                      AS adoptionId,
	                        AD.MEMBER_ID                                        AS memberId,
	                        AD.ANIMAL_ID                                        AS animalId,
	                        AD.VISIT_DATE                                       AS visitDate,
	                        AD.APPLY_DATE                                       AS applyDate,
	                        AD.STATUS                                           AS status,
	                        AD.REJECT_REASON                                    AS rejectReason,
	                        'AD-' || TO_CHAR(AD.APPLY_DATE, 'YYYYMMDD')
	                              || '-' || LPAD(AD.ADOPTION_ID, 2, '0')        AS adoptionNo,
	                        A.ANIMAL_NAME                                       AS animalName,
	                        A.BREED                                             AS breed,
	                        A.GENDER                                            AS gender,
	                        A.AGE                                               AS age,
	                        I.SAVE_FILE_NAME                                    AS mainImage
	                      FROM ADOPTION AD
	                      JOIN ANIMAL A
	                        ON AD.ANIMAL_ID = A.ANIMAL_ID
	                      LEFT OUTER JOIN ANIMAL_IMAGE I
	                        ON A.ANIMAL_ID = I.ANIMAL_ID
	                       AND (I.IS_MAIN = 'Y' OR I.IS_MAIN IS NULL)
	                     WHERE AD.MEMBER_ID = #{memberId}
	                    <if test="status != null and status != ''">
	                       AND AD.STATUS = #{status}
	                    </if>
	                     ORDER BY AD.APPLY_DATE DESC
	                   ) T
	           )
	     WHERE RNUM BETWEEN #{start} AND #{end}
	</select>
	
	<!-- 입양 신청 취소 - 심사중 상태인 본인 신청만 삭제 -->
	<delete id="cancelAdoption" parameterType="map">
	    DELETE FROM ADOPTION
	     WHERE ADOPTION_ID = #{adoptionId}
	       AND MEMBER_ID   = #{memberId}
	       AND STATUS      = '심사중'
	</delete>
	
	
	<!-- =====================================================
	     					내 작성글
	     ===================================================== -->
	     
	<!-- 내 작성글 총 개수 조회(boardType 없으면 전체, keyword 없으면 전체 제목) -->
	<select id="getMyPostsCount" parameterType="map" resultType="int">
	    SELECT COUNT(*)
	      FROM BOARD
	     WHERE MEMBER_ID = #{memberId}
	    <if test="boardType != null and boardType != ''">
	       AND BOARD_TYPE = #{boardType}
	    </if>
	    <if test="keyword != null and keyword != ''">
	       AND TITLE LIKE '%' || #{keyword} || '%'
	    </if>
	</select>
	
	<!-- 내 작성글 목록 조회 (페이징) - 댓글 수(commentCount) 서브쿼리로 집계 -->
	<select id="getMyPostsList" parameterType="map" resultType="BoardVO">
	    SELECT *
	      FROM (
	            SELECT ROWNUM AS RNUM, T.*
	              FROM (
	                    SELECT
	                        B.BOARD_ID                              AS boardId,
	                        B.MEMBER_ID                             AS memberId,
	                        B.BOARD_TYPE                            AS boardType,
	                        B.TITLE                                 AS title,
	                        B.VIEW_COUNT                            AS viewCount,
	                        B.LIKE_COUNT                            AS likeCount,
	                        TO_CHAR(B.CREATE_DATE, 'YYYY.MM.DD')   AS createDate,
	                        (SELECT COUNT(*)
	                           FROM BOARD_COMMENT C
	                          WHERE C.BOARD_ID = B.BOARD_ID)        AS commentCount
	                      FROM BOARD B
	                     WHERE B.MEMBER_ID = #{memberId}
	                    <if test="boardType != null and boardType != ''">
	                       AND B.BOARD_TYPE = #{boardType}
	                    </if>
	                    <if test="keyword != null and keyword != ''">
	                       AND B.TITLE LIKE '%' || #{keyword} || '%'
	                    </if>
	                     ORDER BY B.BOARD_ID DESC
	                   ) T
	           )
	     WHERE RNUM BETWEEN #{start} AND #{end}
	</select>
	
	<!-- 내 작성글 삭제 - 본인 게시글만 삭제 (MEMBER_ID 조건) -->
	<delete id="deleteMyPost" parameterType="map">
	    DELETE FROM BOARD
	     WHERE BOARD_ID  = #{boardId}
	       AND MEMBER_ID = #{memberId}
	</delete>
</mapper>
