package kr.or.ddit.board.dao;

import java.util.List;
import java.util.Map;

import kr.or.ddit.board.vo.BoardCommentVO;
import kr.or.ddit.board.vo.BoardVO;
import kr.or.ddit.board.vo.BoardFileVO;
import kr.or.ddit.board.vo.BoardReportVO;

public interface IBoardDao {
  
	// 게시글 목록 조회
	public List<BoardVO> selectBoardList(Map<String, Object> paramMap);
	
	// 게시글 상세 조회
	public BoardVO selectBoard(int boardId);
	
	// 조회수 증가
	public int updateViewCount(int boardId);
	
	// 게시글 등록
	public int insertBoard(BoardVO boardvo);
	
	// 게시글 수정
	public int updateBoard(BoardVO boardVo);
	
	// 게시글 삭제
	public int deleteBoard(int boardId);
	
	// 댓글 목록 조회
	public List<BoardCommentVO> selectCommentList(int boardId);
	
	// 댓글 등록
	public int insertComment(BoardCommentVO commentVO);
	
	//댓글 삭제
	public int deleteComment(int commentId);
	
	// 추천수 증가
	public int updateLikeCount(int boardId);
    
	// 회원 상태 조회
	public String getMemberStatus(String memberId);
	
	// 첨부파일 등록
	public int insertBoardFile(BoardFileVO fileVo);
	
	// 첨부파일 목록 조회
	public List<BoardFileVO> selectFileList(int boardId);
    
	// 파일 ID로 첨부파일 1개 조회
	public BoardFileVO selectFile(int fileId);
	
	//
	public int insertBoardReport(BoardReportVO reportVo);
	
	//
	public int countBoardReport(int boardId);
}
