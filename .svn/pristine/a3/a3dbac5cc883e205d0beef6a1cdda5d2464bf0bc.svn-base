.main-page {
  min-height: calc(100vh - 88px);
}

.hero-section {
  padding: 56px 0 32px;
}

.hero-box {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  align-items: center;
  gap: 40px;
  background: linear-gradient(135deg, #fff8ef 0%, #fff 100%);
  border: 1px solid #f0e6d8;
  border-radius: 28px;
  padding: 48px;
  overflow: hidden;
}

.hero-badge {
  display: inline-block;
  padding: 8px 14px;
  border-radius: 999px;
  background-color: #fff0db;
  color: #e67e22;
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 18px;
}

.hero-title {
  margin: 0;
  font-size: 48px;
  line-height: 1.2;
  font-weight: 800;
  color: #1f2a44;
}

.hero-description {
  margin: 20px 0 0;
  font-size: 18px;
  line-height: 1.7;
  color: #4b5563;
}

.hero-buttons {
  margin-top: 30px;
  display: flex;
  gap: 14px;
}

.main-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 140px;
  height: 48px;
  padding: 0 22px;
  border-radius: 14px;
  font-size: 15px;
  font-weight: 700;
}

.main-btn-primary {
  background-color: #e67e22;
  color: #fff;
}

.main-btn-primary:hover {
  background-color: #cf6d18;
}

.main-btn-secondary {
  background-color: #1f2a44;
  color: #fff;
}

.main-btn-secondary:hover {
  background-color: #162033;
}

.hero-image-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
}

.hero-image-wrap img {
  width: 100%;
  max-width: 460px;
  border-radius: 24px;
  object-fit: cover;
}

.intro-section {
  padding: 24px 0 0;
}

.section-head {
  text-align: center;
  margin-bottom: 28px;
}

.section-head h2 {
  margin: 0;
  font-size: 36px;
  font-weight: 800;
  color: #1f2a44;
}

.section-head p {
  margin: 12px 0 0;
  font-size: 17px;
  color: #6b7280;
}

.intro-card-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.intro-card {
  background-color: #fff;
  border: 1px solid #ece7df;
  border-radius: 22px;
  padding: 28px;
  box-shadow: 0 10px 24px rgba(0,0,0,0.04);
}

.intro-card-icon {
  width: 56px;
  height: 56px;
  border-radius: 16px;
  background-color: #fff3e6;
  color: #e67e22;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18px;
}

.intro-card-icon .material-symbols-outlined {
  font-size: 28px;
}

.intro-card h3 {
  margin: 0;
  font-size: 24px;
  font-weight: 800;
  color: #1f2a44;
}

.intro-card p {
  margin: 14px 0 20px;
  font-size: 16px;
  line-height: 1.7;
  color: #4b5563;
}

.intro-card a {
  display: inline-block;
  color: #e67e22;
  font-weight: 700;
}

@media (max-width: 1024px) {
  .hero-box {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .hero-buttons {
    justify-content: center;
  }

  .intro-card-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .hero-section {
    padding-top: 32px;
  }

  .hero-box {
    padding: 28px;
  }

  .hero-title {
    font-size: 34px;
  }

  .hero-description {
    font-size: 16px;
  }

  .section-head h2 {
    font-size: 28px;
  }
}