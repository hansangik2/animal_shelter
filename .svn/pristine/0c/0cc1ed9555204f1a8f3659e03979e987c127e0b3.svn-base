/* 1. 공통 레이아웃 및 폰트 설정 */
body {
    margin: 0;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    font-family: 'Pretendard', sans-serif;
}

.layout-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
    box-sizing: border-box;
}

/* 2. HEADER: 한 줄 정렬 및 요소 배치 */
.site-header {
    background-color: #fff;
    border-bottom: 1px solid #eee;
    height: 70px;
    display: flex;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.header-inner {
    display: flex;
    flex-direction: row; /* 가로 한 줄 정렬 */
    align-items: center;
    justify-content: space-between;
}

/* 왼쪽 영역: 로고 + 네비게이션 */
.header-left {
    display: flex;
    align-items: center;
    gap: 40px;
}

.site-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #1a253a;
}

.logo-icon {
    color: #f39c12; /* FAQ 테마색 */
    font-size: 24px !important;
}

.logo-text {
    font-size: 19px;
    font-weight: 800;
}

.main-nav {
    display: flex;
    gap: 20px;
}

.nav-link {
    text-decoration: none;
    color: #444;
    font-size: 15px;
    font-weight: 600;
    transition: color 0.2s;
}

.nav-link:hover {
    color: #f39c12;
}

/* 오른쪽 영역: 검색창 + 유저 액션 */
.header-right {
    display: flex;
    align-items: center;
    gap: 15px;
}

/* 검색창 캡슐 디자인 */
.search-form {
    display: flex;
    align-items: center;
    background-color: #fdfaf7; /* FAQ 배경색 활용 */
    border: 1px solid #eee6de;
    border-radius: 25px;
    padding: 4px 15px;
    width: 240px;
}

.search-input {
    border: none;
    background: transparent;
    outline: none;
    font-size: 13px;
    width: 100%;
}

.search-button {
    border: none;
    background: transparent;
    cursor: pointer;
    color: #555;
    display: flex;
    align-items: center;
}

.search-button .material-symbols-outlined {
    font-size: 20px !important;
}

/* 프로필 링크 (로그인 버튼) */
.profile-link {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid #eee;
    border-radius: 25px;
    padding: 4px 12px;
    text-decoration: none;
    background: #fff;
}

.profile-thumb {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    overflow: hidden;
    background: #eee;
}

.profile-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.profile-name {
    font-size: 13px;
    color: #333;
    font-weight: 500;
}

/* 원형 아이콘 버튼 (회원가입, 로그아웃 등) */
.icon-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid #eee;
    border-radius: 50%;
    text-decoration: none;
    color: #555;
    background: #fff;
    cursor: pointer;
}

.icon-circle .material-symbols-outlined {
    font-size: 20px !important;
}

.header-divider {
    width: 1px;
    height: 16px;
    background-color: #eee;
    margin: 0 5px;
}

.map-section {
	padding: 50px 0;
}

.page-title {
	font-size: 28px;
	font-weight: 800;
	margin-bottom: 30px;
	color: #1a253a;
	text-align: center;
}

#map {
	width: 100%;
	height: 450px;
	background-color: #f9f9f9;
	border-radius: 15px;
	border: 1px solid #eee;
	box-shadow: 0 10px 25px rgba(0,0,0,0.05);
	margin-bottom: 40px;
}

.contact-info-grid {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 30px;
}

.info-card {
	display: flex;
	align-items: flex-start;
	gap: 15px;
	padding: 20px;
	background: #fff;
	border-radius: 12px;
}

.info-card .material-symbols-outlined {
	color: #f39c12;
	font-size: 28px;
}

.info-content h4 {
	margin: 0 0 8px 0;
	font-size: 17px;
	color: #1a253a;
}

.info-content p {
	margin: 0;
	font-size: 15px;
	color: #666;
	line-height: 1.6;
}


/* 3. FOOTER: 다크 네이비 스타일 */
.site-footer {
    background-color: #161a29; /* FAQ footer와 동일 */
    color: #bbb;
    padding: 60px 0 30px 0;
    margin-top: auto;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 40px;
    padding-bottom: 40px;
}

.footer-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 20px;
}

.footer-description {
    font-size: 14px;
    line-height: 1.6;
    color: #888;
}

.footer-column h4 {
    color: #fff;
    font-size: 16px;
    margin-bottom: 20px;
}

.footer-column ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.footer-column li {
    margin-bottom: 12px;
}

.footer-column a {
    text-decoration: none;
    color: #bbb;
    font-size: 14px;
    transition: color 0.2s;
}

.footer-column a:hover {
    color: #f39c12;
}

.footer-contact li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
}

.footer-contact .material-symbols-outlined {
    font-size: 18px !important;
    color: #f39c12;
}

.footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 30px;
    text-align: center;
}