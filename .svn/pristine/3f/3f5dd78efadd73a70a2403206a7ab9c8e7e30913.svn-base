@charset "UTF-8";

:root {
	--green: #0f9d7a;
	--green-soft: #e8faf4;
	--orange-soft: #fff1e8;
	--red-soft: #fdecec;
	--red: #d92d20;
	--line: #e5e7eb;
	--text-sub: #6b7280;
	--primary: #e56b2e;
	--shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
	--radius: 18px;
}

.admin-content {
	padding: 32px;
	max-width: 1400px;
	margin: 0 auto;
}

.admin-page-title {
	display: flex;
	align-items: flex-end;
	justify-content: space-between;
	gap: 20px;
	margin-bottom: 28px;
}

.admin-page-title h1 {
	font-family: "Plus Jakarta Sans", sans-serif;
	font-size: 34px;
	font-weight: 800;
}

.admin-page-title p {
	margin-top: 8px;
	color: var(--text-sub);
	font-weight: 600;
}

.admin-page-title__actions {
	display: flex;
	gap: 12px;
	flex-wrap: wrap;
}

.admin-stats-grid {
	display: grid;
	grid-template-columns: 1fr 2fr 1fr;
	gap: 24px;
	margin-bottom: 28px;
}

.admin-card {
	background: #fff;
	border-radius: var(--radius);
	border: 1px solid #eef0f4;
	box-shadow: var(--shadow);
	padding: 24px;
}

.admin-card--wide {
	min-width: 0;
}

.admin-card--highlight {
	background: linear-gradient(135deg, #0f9d7a, #18b18b);
	color: #fff;
	overflow: hidden;
}

.admin-card--highlight h3 {
	font-size: 14px;
	opacity: 0.9;
}

.highlight-value {
	margin: 12px 0 8px;
	display: flex;
	align-items: baseline;
	gap: 6px;
}

.highlight-value strong {
	font-family: "Plus Jakarta Sans", sans-serif;
	font-size: 42px;
	font-weight: 800;
}

.highlight-value span {
	font-size: 15px;
	font-weight: 700;
}

.stat-card__top {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	margin-bottom: 16px;
}

.stat-card__icon {
	width: 50px;
	height: 50px;
	border-radius: 14px;
	display: flex;
	align-items: center;
	justify-content: center;
}

.stat-card__icon--orange {
	background: #fff1e8;
	color: var(--primary);
}

.stat-badge {
	font-size: 12px;
	font-weight: 800;
	color: var(--green);
	background: var(--green-soft);
	padding: 6px 10px;
	border-radius: 999px;
}

.stat-card h3,
.card-title {
	font-size: 15px;
	color: var(--text-sub);
	margin-bottom: 12px;
	font-weight: 700;
}

.stat-card__value {
	display: flex;
	align-items: baseline;
	gap: 6px;
}

.stat-card__value strong {
	font-family: "Plus Jakarta Sans", sans-serif;
	font-size: 38px;
	font-weight: 800;
}

.stat-card__meta {
	margin-top: 18px;
	padding-top: 16px;
	border-top: 1px solid #f1f3f7;
	display: flex;
	gap: 18px;
	font-size: 13px;
	color: var(--text-sub);
	font-weight: 700;
	flex-wrap: wrap;
}

.progress-box {
	display: flex;
	flex-direction: column;
	gap: 20px;
}

.progress-item__label {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 8px;
	font-size: 13px;
	font-weight: 800;
}

.progress-bar {
	width: 100%;
	height: 10px;
	background: #edf1f5;
	border-radius: 999px;
	overflow: hidden;
}

.progress-bar__fill {
	height: 100%;
	border-radius: 999px;
}

.progress-bar__fill--green {
	background: var(--green);
}

.progress-bar__fill--orange {
	background: var(--primary);
}

.progress-bar__fill--gray {
	background: #b8c0cc;
}

.admin-bottom-grid {
	display: grid;
	grid-template-columns: 2fr 1fr;
	gap: 24px;
}

.section-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 16px;
}

.section-header h2 {
	display: flex;
	align-items: center;
	gap: 8px;
	font-family: "Plus Jakarta Sans", sans-serif;
	font-size: 22px;
	font-weight: 800;
}

.section-header h2 .material-symbols-outlined {
	color: var(--primary);
}

.text-btn {
	font-size: 14px;
	font-weight: 800;
	color: var(--primary);
}

.admin-feed-list {
	background: #eef2f6;
	padding: 10px;
	border-radius: var(--radius);
	display: flex;
	flex-direction: column;
	gap: 10px;
}

.admin-feed-item {
	background: #fff;
	border-radius: 16px;
	padding: 20px;
	display: flex;
	gap: 16px;
	border: 1px solid #edf0f4;
}

.admin-feed-item__icon {
	width: 50px;
	height: 50px;
	border-radius: 14px;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.admin-feed-item__icon--orange {
	background: var(--orange-soft);
	color: var(--primary);
}

.admin-feed-item__icon--red {
	background: var(--red-soft);
	color: var(--red);
}

.admin-feed-item__icon--green {
	background: #e9f8f4;
	color: var(--green);
}

.admin-feed-item__content {
	flex: 1;
	min-width: 0;
}

.admin-feed-item__top {
	display: flex;
	justify-content: space-between;
	gap: 10px;
	margin-bottom: 6px;
}

.admin-feed-item__top h4 {
	font-size: 17px;
	font-weight: 800;
}

.admin-feed-item__top span {
	font-size: 11px;
	color: #9aa2af;
	font-weight: 800;
	flex-shrink: 0;
}

.admin-feed-item__content p {
	font-size: 14px;
	color: var(--text-sub);
	line-height: 1.6;
}

.admin-feed-item__meta,
.admin-feed-item__actions {
	display: flex;
	align-items: center;
	gap: 10px;
	flex-wrap: wrap;
	margin-top: 12px;
}

.admin-feed-item__actions button {
	font-size: 13px;
	font-weight: 800;
	color: var(--primary);
}

.tag {
	display: inline-flex;
	align-items: center;
	padding: 5px 10px;
	border-radius: 999px;
	font-size: 11px;
	font-weight: 800;
	background: #ffe7d8;
	color: #8f340b;
}

.tag--gray {
	background: #eef2f6;
	color: #5b6472;
}

.tag--green {
	background: #dff7ef;
	color: #0e8e6f;
}

.admin-side-widgets {
	display: flex;
	flex-direction: column;
	gap: 24px;
}

.schedule-date {
	font-size: 15px;
	font-weight: 800;
	margin-bottom: 18px;
	color: #374151;
}

.schedule-list {
	display: flex;
	flex-direction: column;
	gap: 16px;
}

.schedule-item {
	display: flex;
	gap: 14px;
	padding-left: 12px;
	border-left: 3px solid #e5e7eb;
}

.schedule-item.is-active {
	border-left-color: var(--primary);
}

.schedule-item__time {
	min-width: 76px;
	font-size: 12px;
	font-weight: 800;
	color: var(--primary);
}

.schedule-item__body h5 {
	font-size: 15px;
	font-weight: 800;
	margin-bottom: 4px;
}

.schedule-item__body p {
	font-size: 13px;
	color: var(--text-sub);
	line-height: 1.5;
}

.admin-widget-btn {
	width: 100%;
	margin-top: 18px;
	border-top: 1px solid var(--line);
	padding-top: 14px;
	font-size: 14px;
	font-weight: 800;
	color: #5b6472;
}

.featured-animal {
	padding: 0;
	overflow: hidden;
}

.featured-animal__image {
	height: 180px;
	position: relative;
	background: #ddd;
}

.featured-animal__badge {
	position: absolute;
	left: 14px;
	top: 14px;
	padding: 7px 10px;
	border-radius: 10px;
	background: rgba(255, 255, 255, 0.88);
	font-size: 11px;
	font-weight: 800;
	color: #7a2f0e;
}

.featured-animal__body {
	padding: 20px;
}

.featured-animal__top {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 10px;
	margin-bottom: 8px;
}

.featured-animal__top h4 {
	font-size: 20px;
	font-weight: 800;
}

.featured-animal__body p {
	font-size: 14px;
	line-height: 1.6;
	color: var(--text-sub);
	margin-bottom: 16px;
}

.fab-btn {
	position: fixed;
	right: 28px;
	bottom: 28px;
	width: 58px;
	height: 58px;
	border-radius: 50%;
	background: var(--primary);
	color: #fff;
	display: flex;
	align-items: center;
	justify-content: center;
	box-shadow: 0 18px 32px rgba(229, 107, 46, 0.3);
	z-index: 60;
}

@media (max-width: 1200px) {
	.admin-stats-grid {
		grid-template-columns: 1fr 1fr;
	}

	.admin-card--wide,
	.admin-card--highlight {
		grid-column: span 2;
	}
}

@media (max-width: 991px) {
	.admin-content {
		padding: 20px 16px 90px;
	}

	.admin-page-title {
		flex-direction: column;
		align-items: flex-start;
	}

	.admin-bottom-grid {
		grid-template-columns: 1fr;
	}

	.fab-btn {
		bottom: 92px;
	}
}

@media (max-width: 767px) {
	.admin-stats-grid {
		grid-template-columns: 1fr;
	}

	.admin-card--wide,
	.admin-card--highlight {
		grid-column: auto;
	}

	.admin-feed-item {
		flex-direction: column;
	}

	.admin-feed-item__top {
		flex-direction: column;
		align-items: flex-start;
	}
}