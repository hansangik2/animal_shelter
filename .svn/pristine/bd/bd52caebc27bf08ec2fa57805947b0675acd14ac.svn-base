* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Pretendard', sans-serif;
  background-color: #f8f6f2;
  color: #1f2937;
}

a {
  text-decoration: none;
  color: inherit;
}

img {
  display: block;
  max-width: 100%;
}

button,
input {
  font: inherit;
}

.layout-container {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 24px;
}

/* header */
.site-header {
  background-color: #ffffff;
  border-bottom: 1px solid #ece7df;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-inner {
  min-height: 88px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 40px;
}

.site-logo {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.logo-icon {
  font-size: 28px;
  color: #e67e22;
}

.logo-text {
  font-size: 22px;
  font-weight: 800;
  color: #1f2a44;
  white-space: nowrap;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 28px;
}

.nav-link {
  font-size: 16px;
  font-weight: 600;
  color: #374151;
  white-space: nowrap;
}

.nav-link:hover {
  color: #e67e22;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 14px;
}

.search-form {
  width: 250px;
  height: 42px;
  display: flex;
  align-items: center;
  border: 1px solid #ddd6cb;
  border-radius: 999px;
  overflow: hidden;
  background-color: #fffaf5;
}

.search-input {
  flex: 1;
  height: 100%;
  border: none;
  outline: none;
  background: transparent;
  padding: 0 14px;
  font-size: 14px;
}

.search-button {
  width: 44px;
  height: 42px;
  border: none;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.admin-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 42px;
  padding: 0 14px;
  border-radius: 999px;
  background-color: #1f2a44;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  white-space: nowrap;
}

.header-divider {
  width: 1px;
  height: 26px;
  background-color: #e5e7eb;
}

.profile-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 5px 12px 5px 5px;
  border: 1px solid #ddd6cb;
  border-radius: 999px;
  background-color: #fff;
}

.profile-thumb {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  overflow: hidden;
  background-color: #eef2f7;
  flex-shrink: 0;
}

.profile-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.profile-name {
  font-size: 14px;
  font-weight: 600;
  color: #374151;
  white-space: nowrap;
}

.icon-circle {
  width: 42px;
  height: 42px;
  border: 1px solid #ddd6cb;
  border-radius: 50%;
  background-color: #fff;
  color: #374151;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* footer */
.site-footer {
  margin-top: 80px;
  background-color: #1f2a44;
  color: #fff;
}

.footer-inner {
  padding: 56px 24px 24px;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1fr;
  gap: 36px;
}

.footer-logo {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 22px;
  font-weight: 800;
}

.footer-logo .material-symbols-outlined {
  color: #f59e0b;
}

.footer-description {
  margin-top: 16px;
  color: #d1d5db;
  line-height: 1.7;
  font-size: 14px;
}

.footer-column h4 {
  margin: 0 0 16px;
  font-size: 16px;
  font-weight: 700;
}

.footer-column ul {
  list-style: none;
  margin: 0;
  padding: 0;
}

.footer-column li {
  margin-bottom: 12px;
}

.footer-column a {
  color: #d1d5db;
  font-size: 14px;
}

.footer-contact li {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #d1d5db;
  font-size: 14px;
}

.footer-contact .material-symbols-outlined {
  color: #f59e0b;
  font-size: 18px;
}

.footer-bottom {
  margin-top: 36px;
  padding-top: 20px;
  border-top: 1px solid rgba(255,255,255,0.12);
  text-align: center;
}

.footer-bottom p {
  margin: 0;
  color: #cbd5e1;
  font-size: 13px;
}

@media (max-width: 1100px) {
  .header-inner {
    flex-direction: column;
    align-items: stretch;
    padding: 16px 0;
  }

  .header-left,
  .header-right {
    justify-content: space-between;
  }

  .main-nav {
    flex-wrap: wrap;
    gap: 18px;
  }

  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 768px) {
  .layout-container {
    padding: 0 16px;
  }

  .header-left {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .header-right {
    flex-wrap: wrap;
  }

  .search-form {
    width: 100%;
  }

  .footer-grid {
    grid-template-columns: 1fr;
  }
}