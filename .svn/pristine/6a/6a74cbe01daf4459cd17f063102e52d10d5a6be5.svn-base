<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper   PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="report">


<insert id="insertAnimalReport" parameterType="AnimalReportVO">

 INSERT INTO ANIMAL_REPORT (
            REPORT_ID,
            MEMBER_ID,
            ANIMAL_TYPE,
            LOCATION,
            STATUS,
            IMAGE_NAME,
            CONTENT,
            REPORT_DATE,
            PROCESS_YN
        ) VALUES (
            SEQ_ANIMAL_REPORT.NEXTVAL,
            #{memberId},
            #{animalType},
            #{location},
            #{status},
            #{imageName},
            #{content},
            SYSDATE,
            'N'
        )
   </insert>    
        
<insert id="insertMemberReport" parameterType="MemberReportVO">
        INSERT INTO MEMBER_REPORT (
            REPORT_ID,
            REPORTER_ID,
            TARGET_ID,
            REASON,
            REPORT_DATE,
            STATUS
        ) VALUES (
            SEQ_MEMBER_REPORT.NEXTVAL,
            #{reporterId},
            #{targetId},
            #{reason},
            SYSDATE,
            'N'
        )
</insert>

</mapper>